// 目标路径: /etc/sing-box/conf.d/00-base.json  (0644)
//
// 所有入站共用的底座配置（无密钥、无占位符，直接原样写入）：
//   1. 关闭访问日志（仅保留 warn 级别错误日志）：避免将个人访问记录落盘或写满磁盘。
//   2. 内置纯净上游 DNS（1.1.1.1）+ 全局默认 ipv4_only 解析：
//      彻底免疫部分海外机房默认系统 DNS 将 gstatic.com / fonts.googleapis.com 解析到
//      203.208.x.x（Google 中国失效 IP）或不通的 IPv6 地址导致网页卡死几十秒的问题。
//   3. 路由首条规则强制拦截私有地址（ip_is_private -> reject）：
//      防止持有代理口令的客户端将本机当作跳板，探测或攻击仅监听 127.0.0.1 的本机无密码服务。
//      sing-box 按文件名字典序追加合并数组，00- 前缀保证此拦截规则永远排在第一位。
{
  "log": {
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "cf-dns",
        "server": "1.1.1.1"
      }
    ]
  },
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "cf-dns",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "ip_is_private": true,
        "action": "reject"
      }
    ],
    "final": "direct"
  }
}
