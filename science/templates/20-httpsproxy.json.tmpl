// 目标路径: /etc/sing-box/conf.d/20-httpsproxy.json  (0600，含代理口令)
//
// HTTP/2 正向代理入站（TLS 加密 + Basic 认证），需要 sing-box >= 1.15.0。
// 专为 Chrome 浏览器（ZeroOmega / SwitchyOmega 选 HTTPS 协议）免客户端直连设计：
//   - 协商 ALPN h2（HTTP/2 多路复用），浏览器与 VPS 仅维持 1 条加密长连接，
//     网页内几十个子域名并发共享同一隧道，避免跨洋重复握手与并发建连丢包。
//   - 同时保留 http/1.1 回退兼容老客户端。
//
// 占位符说明：
//   @@PORT@@           监听端口（新机器若 443 空闲首选 443，否则可用 8443 / 2053 / 8445）
//   @@DOMAIN@@         已解析到本机的域名（证书校验与 SNI 使用）
//   @@CERT_FULLCHAIN@@ TLS 证书链绝对路径（如 /etc/letsencrypt/live/<域名>/fullchain.pem）
//   @@CERT_KEY@@       TLS 私钥绝对路径（如 /etc/letsencrypt/live/<域名>/privkey.pem）
//   @@PROXY_USER@@     代理认证用户名（切勿用 admin/user 等常见弱用户名）
//   @@PROXY_PASSWORD@@ 代理认证高强度随机口令
{
  "inbounds": [
    {
      "type": "http",
      "tag": "httpsproxy-in",
      "listen": "::",
      "listen_port": @@PORT@@,
      "version": [1, 2],
      "users": [
        {
          "username": "@@PROXY_USER@@",
          "password": "@@PROXY_PASSWORD@@"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "@@DOMAIN@@",
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "certificate_path": "@@CERT_FULLCHAIN@@",
        "key_path": "@@CERT_KEY@@"
      }
    }
  ]
}
