// 目标路径: /etc/sing-box/conf.d/10-reality.json  (0600，含私钥与 UUID)
//
// VLESS + XTLS-Vision + REALITY 抗封锁入站（无需域名、无需证书）。
// 被主动探测时会将非授权握手透明转发给伪装站点，探测方拿到的是伪装站点的真实证书。
//
// 占位符说明：
//   @@PORT@@        监听端口（如 8443 或 443）
//   @@DEST_SNI@@    伪装目标域名（如 www.microsoft.com，必须从本机真实可达且支持 TLS 1.3）
//   @@UUID@@        VLESS 客户端 UUID（sing-box generate uuid 生成）
//   @@PRIVATE_KEY@@ REALITY 服务端私钥（sing-box generate reality-keypair 生成）
//   @@SHORT_ID@@    REALITY short_id（1-16 位十六进制，如 openssl rand -hex 8）
{
  "inbounds": [
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": @@PORT@@,
      "users": [
        {
          "uuid": "@@UUID@@",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "@@DEST_SNI@@",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "@@DEST_SNI@@",
            "server_port": 443
          },
          "private_key": "@@PRIVATE_KEY@@",
          "short_id": [
            "@@SHORT_ID@@"
          ]
        }
      }
    }
  ]
}
